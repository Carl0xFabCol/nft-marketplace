# Generated files must be byte-identical across OSes so `--check` modes are stable.
*.generated.ts text eol=lf

# Expected psql outputs compared byte-for-byte by the Phase 2 runbook.
packages/database/scripts/rehearsal/*.txt text eol=lf
packages/database/migrations/*.sql text eol=lf
# Rollback/rehearsal SQL: phase3b_down.sql rebuilds CRLF function bodies from LF text.
packages/database/scripts/rollback/*.sql text eol=lf
packages/database/scripts/rehearsal/*.sql text eol=lf
