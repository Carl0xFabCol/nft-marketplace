{
  "extends": "../../packages/config/tsconfig/node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "ES2020",
    "lib": ["ES2020"],
    // The indexer runs through tsx/vitest and has no emit step. "bundler"
    // resolution honours package `exports` subpaths (e.g.
    // @marketplace/contracts/abis/generated/events) and picks the libraries'
    // .d.ts entry points instead of type-checking their .ts sources.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
