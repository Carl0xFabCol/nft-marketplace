# ═══════════════════════════════════════════════════════════════════════════════
# MARKETPLACE INDEXER - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# RPC PROVIDERS (Multi-Provider Strategy)
# ───────────────────────────────────────────────────────────────────────────────

# PRIMARY FAST RPC (REQUIRED)
# Use a fast, reliable RPC for recent blocks
# Free options: Alchemy (300M CU/month), Infura (100k requests/day)
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
FAST_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ARCHIVE RPC (OPTIONAL but RECOMMENDED)
# Use an archive node for deep historical data
# Free archive options: Alchemy Archive tier, Infura Archive addon
# If not provided, historical queries may fail gracefully
ARCHIVE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ARCHIVE_KEY

# FALLBACK RPC (OPTIONAL but RECOMMENDED)
# Backup RPC in case primary fails
# Can use public nodes: https://rpc.ankr.com/eth_sepolia (rate-limited)
# Or another provider for redundancy
FALLBACK_RPC_URL=https://rpc.ankr.com/eth_sepolia

# ARCHIVE RPC TOKEN (OPTIONAL)
# Some archive providers require auth tokens
ARCHIVE_RPC_TOKEN=

# ───────────────────────────────────────────────────────────────────────────────
# PERFORMANCE & BATCHING
# ───────────────────────────────────────────────────────────────────────────────

# Maximum block range to fetch in a single iteration
# Smaller = more frequent updates, less RPC stress
# Larger = fewer API calls, faster initial sync
# Recommended: 1000-5000 for Sepolia, 100-500 for Mainnet
BATCH_SIZE=5000

# Maximum parallel RPC requests when fetching events from multiple contracts
# Higher = faster, but may hit rate limits
# Recommended: 2-5
MAX_PARALLEL_REQUESTS=3

# Polling interval in milliseconds (how often to check for new blocks)
# 15000 = 15 seconds (matches Sepolia block time)
# Adjust based on chain block time
POLLING_INTERVAL_MS=15000

# ───────────────────────────────────────────────────────────────────────────────
# RETRY & RESILIENCE
# ───────────────────────────────────────────────────────────────────────────────

# Maximum retry attempts for failed RPC calls
MAX_RETRY_ATTEMPTS=3

# Initial backoff delay in milliseconds (exponential backoff)
INITIAL_BACKOFF_MS=1000

# ───────────────────────────────────────────────────────────────────────────────
# DATABASE (Supabase)
# ───────────────────────────────────────────────────────────────────────────────

# Supabase project URL
# Example: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (NOT anon key - needs elevated permissions)
# Found in: Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ───────────────────────────────────────────────────────────────────────────────
# EXTERNAL APIS
# ───────────────────────────────────────────────────────────────────────────────

# Etherscan API key (OPTIONAL)
# Used for fetching contract deployment blocks
# Free tier: 5 calls/second
# Get yours at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# ───────────────────────────────────────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────────────────────────────────────

# Log level: trace, debug, info, warn, error, fatal
# Production: info or warn
# Development: debug or trace
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════════════════════
# QUICK START GUIDE
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. FAST_RPC_URL (REQUIRED):
#    - Alchemy Free: https://www.alchemy.com/ (300M CU/month)
#    - Infura Free: https://www.infura.io/ (100k requests/day)
#    - QuickNode Trial: https://www.quicknode.com/ (trial available)
#
# 2. ARCHIVE_RPC_URL (OPTIONAL):
#    - Alchemy Archive: Available on Growth plan
#    - Infura Archive: Available with addon
#    - If not set, deep historical queries will be skipped
#
# 3. FALLBACK_RPC_URL (OPTIONAL):
#    - Public nodes: https://rpc.ankr.com/eth_sepolia (rate-limited)
#    - Or use a second provider for redundancy
#
# 4. SUPABASE:
#    - Sign up at https://supabase.com (free tier available)
#    - Create a new project
#    - Run the database migrations from packages/database/migrations/
#    - Copy your project URL and service_role key
#
# 5. Start the indexer:
