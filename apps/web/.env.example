# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: dedicated Pinata IPFS gateway (e.g. https://my-gateway.mypinata.cloud/ipfs)
NEXT_PUBLIC_PINATA_GATEWAY=
# Optional: Pinata gateway access token. This is embedded in client requests,
# so use a scoped/revocable token.
NEXT_PUBLIC_PINATA_GATEWAY_KEY=
